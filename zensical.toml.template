[project]
site_name = "Soliplex"
site_url = "https://soliplex.github.io/"
dev_addr = "127.0.0.1:9001"
repo_name = "soliplex/soliplex"
repo_url = "https://github.com/soliplex/soliplex"

# Site-only styles shipped by an aggregated project (copied into docs/ with it).
extra_css = ["template/stylesheets/extra.css"]

# Navigation. Local pages are listed literally; each "@auto:<project>" stub is
# expanded by scripts/build-docs.py from the copied docs/<project>/ tree, so new,
# renamed, or removed upstream pages flow into the site automatically. Edit section
# structure here; tune individual titles via the [nav_title_overrides] table at the
# end of this template (that table is stripped from the generated zensical.toml).
nav = [
  { "Home" = "index.md" },
  { "Core Platform" = "@auto:soliplex" },
  { "Deployment" = [
    { "Docker Compose Template" = "@auto:template" },
    { "Concierge" = "@auto:concierge" },
  ]},
  { "User Interfaces" = [
    { "Chatbot Widget" = "@auto:chatbot-widget" },
    { "Flutter UI" = "@auto:frontend" },
  ]},
  { "Supporting Tools" = [
    { "Ingester Agents" = "@auto:ingester-agents" },
    { "PDF Splitter" = "@auto:pdf-splitter" },
    { "Bubble Sandbox" = "@auto:bubble-sandbox" },
    { "Exquisite" = "@auto:exquisite" },
  ]},
]

# --------------------------------------------------------------------------
# Theme
# --------------------------------------------------------------------------
[project.theme]
logo = "img/logo.png"
language = "en"

features = [
  "content.code.annotate",
  "content.code.copy",
  "content.code.select",
  "content.footnote.tooltips",
  "content.tabs.link",
  "content.tooltips",
  "navigation.footer",
  "navigation.indexes",
  "navigation.instant",
  "navigation.instant.prefetch",
  "navigation.instant.progress",
  "navigation.path",
  "navigation.tabs",
  "navigation.tabs.sticky",
  "navigation.top",
  "navigation.tracking",
  "search.highlight",
  "search.share",
  "search.suggest",
  "toc.follow",
]

[project.theme.icon]
repo = "fontawesome/brands/github-alt"

[[project.theme.palette]]
media = "(prefers-color-scheme)"
toggle.icon = "material/lightbulb-auto"
toggle.name = "Switch to light mode"

[[project.theme.palette]]
media = "(prefers-color-scheme: light)"
scheme = "default"
primary = "gray"
accent = "blue"
toggle.icon = "material/lightbulb"
toggle.name = "Switch to dark mode"

[[project.theme.palette]]
media = "(prefers-color-scheme: dark)"
scheme = "slate"
primary = "blue"
accent = "amber"
toggle.icon = "material/lightbulb-outline"
toggle.name = "Switch to system preference"

# --------------------------------------------------------------------------
# Markdown extensions
# --------------------------------------------------------------------------
[project.markdown_extensions.admonition]
[project.markdown_extensions.attr_list]
[project.markdown_extensions.footnotes]
[project.markdown_extensions.pymdownx.details]
# Icon shortcodes such as ':lucide-wand-sparkles:' (used by soliplex-template).
[project.markdown_extensions.pymdownx.emoji]
emoji_generator = "zensical.extensions.emoji.to_svg"
emoji_index = "zensical.extensions.emoji.twemoji"
[project.markdown_extensions.pymdownx.highlight]
anchor_linenums = true
line_spans = "__span"
pygments_lang_class = true
use_pygments = true
[project.markdown_extensions.pymdownx.inlinehilite]
# '--8<-- "path"' includes are written relative to the upstream repo's root, so
# each project that uses them needs its submodule root on the search path.
# check_paths makes an unresolved include fail the build instead of vanishing.
[project.markdown_extensions.pymdownx.snippets]
base_path = [".", "projects/template"]
check_paths = true
[project.markdown_extensions.pymdownx.superfences]
custom_fences = [
  { name = "mermaid", class = "mermaid", format = "pymdownx.superfences.fence_code_format" },
]

# >>> build-docs settings (everything below is stripped from the generated
# zensical.toml by scripts/build-docs.py — it is NOT zensical config) >>>
#
# Optional nav title overrides, keyed by a copied doc's relative path OR a
# directory's relative path. Anything not listed here is auto-titled from its
# file/directory name (acronym-aware). Use this to hand-tune awkward auto-titles.
[nav_title_overrides]
"soliplex/overview.md" = "Platform Overview"
"soliplex/config" = "Configuration"
"soliplex/server" = "Setup"
"soliplex/examples" = "Examples"
"soliplex/config/oidc_providers.md" = "OIDC Authentication"
"soliplex/config/dburis.md" = "SQLAlchemy DBURIs"
"soliplex/config/agui.md" = "AG-UI"
"soliplex/config/filesystem_layout.md" = "Filesystem Layout"
"soliplex/server/sse_resume.md" = "SSE Resume"
"template/getting-started" = "Getting Started"
"template/users" = "Using a Generated Stack"
"template/upgrades" = "Upgrading a Generated Stack"
"template/getting-started/generator.md" = "Generate a Project"
"template/getting-started/using-the-skill.md" = "Using the Skill"
"template/users/operations/room-provisioning" = "Room Provisioning"
"template/upgrades/move-to-src-layout.md" = "Move to the src/ Layout"
"concierge/index.md" = "Overview"
"concierge/tasks/rooms/index.md" = "The Concierge"
"concierge/tasks/admin/index.md" = "Administering Requests"
"concierge/tasks/provisioners" = "Implementing a Provisioner"
"concierge/reference/api.md" = "Python API"
"concierge/reference/cli.md" = "CLI Scripts"
"concierge/skills/soliplex-concierge-admin.md" = "soliplex-concierge-admin"
"concierge/skills/soliplex-concierge-installer.md" = "soliplex-concierge-installer"
"concierge/skills/soliplex-concierge-room.md" = "soliplex-concierge-room"

# Copied Markdown that is not a page, kept out of the generated nav and the
# orphan check (it still builds). Docs-relative files or directories.
[nav_exclude]
paths = [
  # '--8<--' snippet fragments included by other soliplex-template pages.
  "template/getting-started/includes",
]
